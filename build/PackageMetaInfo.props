<Project>
    <PropertyGroup>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <Title>AtomUI.Icons.Material</Title>
        <Author>Qinware Technologies Ltd.</Author>
        <Authors>$(Author)</Authors>
        <Description>Google Material icons library for AtomUI OSS</Description>
        <PackageTags>avalonia;AntDesigin;AtomUI;Icons Library</PackageTags>
        <ProjectUrl>https://qinware.com</ProjectUrl>
        <RepositoryUrl>https://github.com/chinware/AtomUI</RepositoryUrl>
        <Company>Qinware Technologies Ltd.</Company>
        <Copyright>Copyright ©2018-2025, Qinware Technologies Co.,Ltd., All Rights Reserved.</Copyright>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Version>$(MaterialVersion)</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../resources/logo.png" Visible="False" Pack="True" PackagePath="/"/>
        <None Include="$(MSBuildThisFileDirectory)../LICENSE" Visible="False" Pack="True" PackagePath="/"/>
        <None Include="$(MSBuildThisFileDirectory)../README.nuget.md" Visible="False" Pack="True" PackagePath="/"/>
    </ItemGroup>

</Project>