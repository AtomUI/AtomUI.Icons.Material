<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:rxui="http://reactiveui.net"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="using:AtomUI.Desktop.Controls"
             xmlns:workspaceviews="using:MaterialGallery.Workspace.Views"
             x:Class="MaterialGallery.Workspace.Views.WorkspaceWindow"
             IsPinCaptionButtonEnabled="True"
             WindowState="Normal"
             WindowStartupLocation="CenterScreen"
             Height="900"
             Width="1300"
             >
    <atom:Window.Logo>
        <Image Source="/Assets/gallery-logo.png" />
    </atom:Window.Logo>
    <DockPanel LastChildFill="True">
    </DockPanel>
</atom:Window>