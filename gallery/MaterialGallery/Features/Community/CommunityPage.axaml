<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="using:MaterialGallery.Features.Community"
             x:Class="MaterialGallery.Features.Community.CommunityPage"
             x:DataType="gallery:CommunityViewModel">
    <atom:ScrollViewer HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       AllowAutoHide="False">
        <StackPanel Margin="32" Spacing="12">
            <atom:TextBlock Text="Community"
                            FontSize="28"
                            FontWeight="Bold" />
            <atom:TextBlock Text="Project resources, support, and contribution links." />
        </StackPanel>
    </atom:ScrollViewer>
</UserControl>
