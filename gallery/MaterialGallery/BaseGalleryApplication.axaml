<Application
    x:Class="MaterialGallery.BaseGalleryApplication"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Styles>
        <Styles>
            <Styles.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="../Controls/IconGallery/Themes/IconGalleryThemes.axaml"/>
                        <ResourceInclude Source="../Controls/Navigation/Themes/NavigationThemes.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Styles.Resources>
        </Styles>
    </Application.Styles>
</Application>