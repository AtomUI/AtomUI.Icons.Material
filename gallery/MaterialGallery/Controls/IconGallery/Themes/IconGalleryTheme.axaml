<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/icons/material/icons-gallery"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type gallery:IconGallery}" TargetType="gallery:IconGallery">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <atom:SearchEdit Name="{x:Static gallery:IconGalleryThemeConstants.SearchInputPart}"
                                     PlaceholderText="{TemplateBinding SearchPlaceholder}"
                                     HorizontalAlignment="Stretch"
                                     DockPanel.Dock="Top" />
                    <Grid>
                        <atom:ScrollViewer Name="{x:Static gallery:IconGalleryThemeConstants.ScrollViewerPart}"
                                           IsVisible="{TemplateBinding HasMatches}"
                                           VerticalScrollBarVisibility="Auto"
                                           AllowAutoHide="False"
                                           BringIntoViewOnFocusChange="False">
                            <ItemsControl ItemsSource="{TemplateBinding IconInfos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel LineSpacing="10" ItemSpacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gallery:IconInfo">
                                        <gallery:IconInfoItem
                                            IconName="{Binding Name}"
                                            Icon="{Binding Icon}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </atom:ScrollViewer>
                        <Border Name="IconGalleryEmptyState"
                                IsVisible="{Binding !HasMatches, RelativeSource={RelativeSource TemplatedParent}}"
                                IsHitTestVisible="False"
                                Padding="24">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <atom:TextBlock Text="{TemplateBinding EmptyTitle}"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />
                                <atom:TextBlock Text="{TemplateBinding EmptyDescription}"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Style Selector="^ /template/ atom|SearchEdit#PART_SearchInput">
            <Setter Property="Margin"
                    Value="{gallery:IconGalleryTokenResource SearchInputMargin}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
