<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/icons/material/icons-gallery"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type gallery:IconInfoItem}" TargetType="gallery:IconInfoItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Vertical"
                                Spacing="{DynamicResource {x:Static atom:SharedTokenKey.SpacingLG}}">
                        <atom:IconPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Icon="{TemplateBinding Icon}"/>
                        <atom:TextBlock
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding IconName}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{DynamicResource {x:Static  atom:SharedTokenKey.EnableMotion}}"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource {x:Static atom:SharedTokenKey.BorderRadius}}" />
        <Setter Property="Padding" Value="{DynamicResource {x:Static atom:SharedTokenKey.PaddingXS}}" />
        <Setter Property="Height" Value="{DynamicResource {x:Static gallery:IconGalleryTokenKey.InfoItemSize}}" />
        <Setter Property="Width" Value="{DynamicResource {x:Static gallery:IconGalleryTokenKey.InfoItemSize}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static atom:SharedTokenKey.FontSizeSM}}" />
        <Setter Property="Cursor" Value="Hand" />
        
        <Style Selector="^ /template/ atom|IconPresenter">
            <Setter Property="Height" Value="{DynamicResource {x:Static gallery:IconGalleryTokenKey.IconSize}}" />
            <Setter Property="Width" Value="{DynamicResource {x:Static gallery:IconGalleryTokenKey.IconSize}}" />
        </Style>
        
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource {x:Static atom:SharedTokenKey.ColorBgTextHover}}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>